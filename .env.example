# Monorepo env example. Copy the relevant values into each app.
#
# Web (apps/web/.env) — server-only, never exposed to the browser:
#   BACKEND_API_URL=http://localhost:3000/api/v1
#   APP_URL=http://localhost:3002
#   BACKEND_REQUEST_TIMEOUT_MS=15000
#
# Mobile (apps/mobile/.env) — EXPO_PUBLIC_* are embedded in the bundle (no secrets):
#   EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
#   EXPO_PUBLIC_ENVIRONMENT=development
#   EXPO_PUBLIC_SENTRY_DSN=
