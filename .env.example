# Monorepo env example. Copy the relevant values into each app.
#
# Web (apps/web/.env) — server-only, never exposed to the browser:
#   BACKEND_API_URL=http://localhost:3000/api/v1
#   APP_URL=http://localhost:3002
#   BACKEND_REQUEST_TIMEOUT_MS=15000
#   # Origen público del backend para el socket de chat (lo abre el NAVEGADOR, así que
#   # debe resolverlo la máquina del usuario). Opcional: sin él se usa el valor horneado
#   # en NEXT_PUBLIC_BACKEND_ORIGIN durante el build.
#   BACKEND_PUBLIC_ORIGIN=http://localhost:3000
#
# Mobile (apps/mobile/.env) — EXPO_PUBLIC_* are embedded in the bundle (no secrets):
#   EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
#   EXPO_PUBLIC_ENVIRONMENT=development
#   EXPO_PUBLIC_SENTRY_DSN=
