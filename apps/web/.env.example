# Server-only backend base URL. Include the API prefix.
BACKEND_API_URL=http://localhost:3001/api/v1

# Backend origin reachable from the BROWSER (no path) — used only to open the
# chat WebSocket directly, bypassing the BFF, which cannot proxy a socket
# upgrade. In dev this is the same host:port as BACKEND_API_URL minus the
# path, since the port is published to the host either way.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:3001

# Canonical public frontend URL used for metadata.
APP_URL=http://localhost:3002

# Default timeout for server-side backend calls.
BACKEND_REQUEST_TIMEOUT_MS=15000

# Identidades visuales por host (multi-inquilino). JSON que asocia host a
# paleta parcial; lo no declarado se hereda de la identidad de referencia.
# Vacío o ausente = una sola marca. Ver src/shared/theme/README.md.
# TENANT_THEMES={"lifthouse.gymsheet.app":{"id":"lifthouse","name":"LiftHouse","dark":{"accent":"#ff5a1f"}}}

# Secreto para firmar las URLs del proxy de imágenes (`/api/media`). Obligatorio
# en producción; en desarrollo cae a un valor fijo. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEDIA_PROXY_SECRET=
