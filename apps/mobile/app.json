{
  "expo": {
    "name": "GymSheet",
    "slug": "gymsheet",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "gymsheet",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.gymsheet.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.gymsheet.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "GymSheet usa Face ID para proteger la sesión guardada en este dispositivo."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "gymsheet",
          "project": "mobile"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GymSheet usa tu ubicación, solo al finalizar un entrenamiento, para verificar tu racha en la sede donde entrenaste."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GymSheet usa tus fotos y vídeos para que elijas una imagen de perfil o publiques una story.",
          "cameraPermission": "GymSheet usa la cámara para que hagas una foto o grabes un vídeo y lo publiques como story.",
          "microphonePermission": "GymSheet usa el micrófono para grabar el sonido de los vídeos que publiques como story."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000"
        }
      ],
      "./plugins/with-path-spaces-fix",
      "./plugins/with-cleartext-domains"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f836e62f-66c6-4216-a7bd-8d5ac49c8dd8"
      }
    },
    "owner": "pablo28809",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f836e62f-66c6-4216-a7bd-8d5ac49c8dd8"
    }
  }
}
