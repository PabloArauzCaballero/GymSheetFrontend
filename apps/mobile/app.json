{
  "expo": {
    "name": "GymSheet",
    "slug": "gymsheet",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "gymsheet",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.gymsheet.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.gymsheet.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "GymSheet usa Face ID para proteger la sesión guardada en este dispositivo."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "gymsheet",
          "project": "mobile"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GymSheet usa tu ubicación, solo al finalizar un entrenamiento, para verificar tu racha en la sede donde entrenaste."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GymSheet usa tus fotos para que elijas una imagen de perfil o publiques una story.",
          "cameraPermission": "GymSheet usa la cámara para que hagas una foto y la publiques como story."
        }
      ],
      "./plugins/with-fmt-consteval-fix",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
