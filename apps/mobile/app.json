{
  "expo": {
    "name": "REPP",
    "slug": "gymsheet",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "gymsheet",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.gymsheet.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.gymsheet.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "REPP usa Face ID para proteger la sesi\u00f3n guardada en este dispositivo."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "gymsheet",
          "project": "mobile"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "REPP usa tu ubicaci\u00f3n, solo al finalizar un entrenamiento, para verificar tu racha en la sede donde entrenaste."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "REPP usa tus fotos y v\u00eddeos para que elijas una imagen de perfil o publiques una story.",
          "cameraPermission": "REPP usa la c\u00e1mara para que hagas una foto o grabes un v\u00eddeo y lo publiques como story.",
          "microphonePermission": "REPP usa el micr\u00f3fono para grabar mensajes de voz y el sonido de los v\u00eddeos que publiques como story."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2E8B7B"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.gymsheet.mobile.widgets",
          "groupIdentifier": "group.app.gymsheet.mobile",
          "widgets": [
            {
              "name": "RepiGym",
              "displayName": "Repi",
              "description": "Repi te recuerda ir al gym. Con cariño. Más o menos.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "accessoryRectangular", "accessoryInline"]
              }
            },
            {
              "name": "RepiMatches",
              "displayName": "Matches",
              "description": "Quién espera tu respuesta. En la pantalla bloqueada, sin nombres.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "accessoryRectangular"]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RepiGym",
              "label": "Repi",
              "description": "Repi te recuerda ir al gym. Con cariño. Más o menos.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/mascot/wink.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "RepiMatches",
              "label": "Matches",
              "description": "Quién espera tu respuesta.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/mascot/flirty.png",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-path-spaces-fix",
      "./plugins/with-cleartext-domains",
      [
        "expo-audio",
        {
          "microphonePermission": "REPP usa el micr\u00f3fono para grabar mensajes de voz que eliges enviar en el chat y el sonido de los v\u00eddeos que publiques como story."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f836e62f-66c6-4216-a7bd-8d5ac49c8dd8"
      }
    },
    "owner": "pablo28809",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f836e62f-66c6-4216-a7bd-8d5ac49c8dd8"
    }
  }
}
