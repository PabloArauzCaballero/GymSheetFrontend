{
  "name": "@gymsheet/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "go": "expo start --go",
    "go:tunnel": "expo start --go --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "type-check": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --passWithNoTests",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "test:stories": "node --test --experimental-strip-types src/components/story-viewers-presentation.test.ts",
    "test:tour": "node --test --experimental-strip-types src/state/tour-queue.test.ts",
    "eas-build-pre-install": "node scripts/ensure-install.mjs && node scripts/check-api-url.mjs",
    "check:api-url": "node scripts/check-api-url.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gymsheet/anatomy": "*",
    "@gymsheet/api-client": "*",
    "@gymsheet/auth": "*",
    "@gymsheet/design-tokens": "*",
    "@gymsheet/domain": "*",
    "@gymsheet/hooks": "*",
    "@gymsheet/notifications": "*",
    "@gymsheet/observability": "*",
    "@gymsheet/schemas": "*",
    "@gymsheet/types": "*",
    "@hookform/resolvers": "^5.2.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
