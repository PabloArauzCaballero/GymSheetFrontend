# Public runtime config for the Expo app. NEVER put secrets here — everything
# prefixed EXPO_PUBLIC_ is embedded in the client bundle.

# Backend base URL (include the API prefix). Mobile talks to the backend
# directly, así que `localhost` casi nunca sirve: el teléfono —o el emulador—
# no es la máquina donde corre la API.
#
#   iPhone o Android físico ....... la IP de LAN del ordenador
#                                   (macOS: ipconfig getifaddr en0)
#                                   (Windows: ipconfig, IPv4 del adaptador activo)
#   Emulador de Android ........... http://10.0.2.2:PUERTO/api/v1
#                                   10.0.2.2 es como el emulador ve al anfitrión
#   Simulador de iOS .............. localhost sirve, pero la IP de LAN también
#
# Esa IP caduca al cambiar de red. Si la app falla el acceso con un error de
# red, comprobar esto antes que nada.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3011/api/v1

# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# Sentry DSN (safe to expose; optional in development).
EXPO_PUBLIC_SENTRY_DSN=
