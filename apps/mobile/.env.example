# Public runtime config for the Expo app. NEVER put secrets here — everything
# prefixed EXPO_PUBLIC_ is embedded in the client bundle.

# Backend base URL (include the API prefix). Deja `localhost` para desarrollo:
# `src/config/env.ts` lo cambia en cada dispositivo por la IP de LAN con la que
# ese dispositivo llegó a Metro, así que sirve igual para el simulador de iOS,
# el emulador de Android y cualquier iPhone o Android físico con Expo Go en la
# misma Wi-Fi —todos a la vez, sin editar nada al cambiar de red—. Las URL de
# fotos que devuelve el backend local se corrigen de la misma forma.
#
# Sólo hay que poner otra cosa si el teléfono NO está en la misma red que el
# Mac (p. ej. con `yarn go:tunnel`): entonces hace falta la URL pública del
# backend, porque el túnel sólo lleva a Metro, no a la API.
EXPO_PUBLIC_API_URL=http://localhost:3011/api/v1

# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# Sentry DSN (safe to expose; optional in development).
EXPO_PUBLIC_SENTRY_DSN=
